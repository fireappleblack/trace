# generated: 2026-06-06T16:30:04Z by flatten.py — do not edit this block
# flatten:end

# ─────────────────────────────────────────────────────────────────────────
# Trace — container image (Podman / Docker compatible)
# ─────────────────────────────────────────────────────────────────────────
# IMPORTANT: build with the PROJECT ROOT as the context, not trace-server/,
# because the image needs the single canonical trace.html that lives one
# level up from this file:
#
#     cd /path/to/project-root      # the dir containing trace.html
#     podman build -f trace-server/Containerfile -t trace:latest .
#
# The image mirrors the repo layout so app.py finds ../trace.html exactly as
# it does in local dev:
#
#     /app/trace.html
#     /app/trace-server/{app.py,db.py,schema.sql,requirements.txt}
#
# SQLite data is written to /data (mount a volume there to persist it).
# ─────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim

# Don't write .pyc files; flush stdout/stderr immediately so logs show up.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install Python deps first for better layer caching. Only the requirements
# file changes rarely, so this layer is reused across code edits.
COPY trace-server/requirements.txt /app/trace-server/requirements.txt
RUN pip install --no-cache-dir -r /app/trace-server/requirements.txt

# Copy the server package and the single client file.
COPY trace-server/ /app/trace-server/
COPY trace.html    /app/trace.html

# Guard against a stale duplicate sneaking into the image: the client must be
# served from /app/trace.html only.
RUN rm -f /app/trace-server/trace.html

# Create a non-root user and a writable data dir for the SQLite file.
RUN useradd --uid 1000 --create-home app \
    && mkdir -p /data \
    && chown -R app:app /data /app
USER app

WORKDIR /app/trace-server

# Default to a SQLite database on the mounted volume. Override with a
# postgres:// URL (and uncomment psycopg2-binary in requirements.txt) to use
# Postgres instead — needed if you want more than one replica.
ENV DATABASE_URL=sqlite:////data/trace.db \
    PORT=5000

EXPOSE 5000

# gunicorn is the production WSGI server. Two sync workers is plenty for this
# app; each worker imports app.py after fork and so gets its own SQLite
# connection (we deliberately do NOT use --preload, which would share one
# connection across workers). For Postgres you can raise the worker count.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", \
     "--timeout", "120", "--access-logfile", "-", "app:app"]
