# Copy to .secrets.env (gitignored) and fill in real values, then run
# ./apply-admin.sh. Applied via --from-env-file, NEVER shell-interpolated, so
# values may safely contain @ : / # [ ] etc.
#
# Generate a strong secret key, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Bootstrap (break-glass) superadmin. This account is re-asserted from these
# values on every startup, so manage ITS password here, not in the UI. All
# other admins are created in-app by a superadmin and own their passwords.
ADMIN_USERNAME=root
ADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_SECRET_KEY=replace-with-a-32+byte-random-string
