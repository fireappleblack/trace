# Copy this file to `.secrets.env` (gitignored) and set a real root password.
# Read by apply-mariadb.sh to create the `mariadb-root` Secret out-of-band, so
# the password never enters git.
#
# Format: KEY=VALUE, one per line, taken LITERALLY by
# `kubectl create secret --from-env-file` — no quotes, no trailing space/blank
# line. Special characters (^ & @ : / [ ] #) are safe.
#
# Only the root password is needed here. Per-site databases and their own
# least-privilege users are created later by wordpress/apply-site.sh, each with
# its own generated password — none of which live in git either.
MARIADB_ROOT_PASSWORD=replace-with-a-strong-password
