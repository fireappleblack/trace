# Build-context excludes (read by Podman and Docker).
# Keeps the image lean and prevents local state from leaking into the image.
# This file belongs at the build-context root — the directory that contains
# trace.html and trace-server/ — since that's where `podman build ... .` runs.

# Python build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo

# Local SQLite databases and WAL sidecars (e.g. from `python app.py`)
**/*.db
**/*.db-wal
**/*.db-shm

# Version control
.git/
.gitignore

# Editor / OS noise
**/.DS_Store
**/.idea/
**/.vscode/

# Stray / local-only files seen in the working dir
1
mnt/
.v_ziprip-game/

# Docs and deploy manifests aren't needed inside the runtime image
**/README.md
trace-server/deploy/
