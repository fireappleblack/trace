# Copy this file to `.secrets.env` (gitignored) and fill in real values. It is
# read by apply-backups.sh to create the `backup-object-store` Secret
# out-of-band, so these credentials never enter git.
#
# Format: KEY=VALUE, one per line. Values are taken LITERALLY by
# `kubectl create secret --from-env-file` (no shell, no quoting), so special
# characters (^ & @ : / [ ] #) are safe — do NOT wrap in quotes, and avoid a
# trailing space or blank line after a value.
#
# ── OCI Object Storage, S3 compatibility ──
# Get the keys from the OCI console:
#   Identity & Security → Users → (your user) → Customer Secret Keys → Generate.
# The console shows the Access Key and (once only) the Secret Key.
#
# OS_ENDPOINT format:
#   https://<object-storage-namespace>.compat.objectstorage.<region>.oraclecloud.com
#   (Find <object-storage-namespace> under: Tenancy details → Object Storage
#    Namespace. <region> is e.g. uk-london-1.)
#
# Create the bucket first in the OCI console (Object Storage → Buckets), then
# put its name in OS_BUCKET. Use a PRIVATE bucket.
OS_BUCKET=cluster-backups
OS_REGION=uk-london-1
OS_ENDPOINT=https://EXAMPLENAMESPACE.compat.objectstorage.uk-london-1.oraclecloud.com
OS_ACCESS_KEY_ID=replace-with-customer-secret-key-access-id
OS_SECRET_ACCESS_KEY=replace-with-customer-secret-key-secret
