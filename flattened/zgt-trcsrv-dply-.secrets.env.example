# Copy this file to `.secrets.env` (which is gitignored) and fill in a real
# password. `.secrets.env` is read by apply-db.sh to create the `trace-db`
# Kubernetes Secret out-of-band, so the real password never enters git.
#
# Format: KEY=VALUE, one per line. The value is taken LITERALLY by
# `kubectl create secret --from-env-file` (no shell, no quoting), so special
# characters like ^ & @ : / [ ] # are safe here — do NOT wrap in quotes, and
# avoid a trailing space or blank line after the password.
POSTGRES_USER=trace
POSTGRES_DB=trace
POSTGRES_PASSWORD=replace-with-a-strong-password
